@using Slingcessories.Services
@inject UserStateService UserStateService
@inject AuthService AuthService
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (RequiresAuthentication(routeData.PageType) && string.IsNullOrEmpty(UserStateService.CurrentUserId))
        {
            <LayoutView Layout="@typeof(MainLayout)">
                <RedirectToLogin />
            </LayoutView>
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        }
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await UserStateService.InitializeAsync();

        // If no user is selected, force unauthenticated users to login.
        if (string.IsNullOrEmpty(UserStateService.CurrentUserId))
        {
            var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (!currentPath.StartsWith("login", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/login", replace: true);
            }
        }
    } // Closing brace for OnInitializedAsync method

    private bool RequiresAuthentication(Type pageType)
    {
        return pageType != typeof(Pages.Login)
            && pageType != typeof(Pages.Register);
    }
}
