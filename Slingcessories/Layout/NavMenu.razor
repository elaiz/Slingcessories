@using Slingcessories.Services
@inject UserStateService UserStateService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Slingcessories</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @if (!string.IsNullOrEmpty(UserStateService.CurrentUserId))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/slingshots">
                    <span class="bi bi-diagram-3-fill" aria-hidden="true"></span> Slingshots
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/accessories/false">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Accessories
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/accessories/true">
                    <span class="bi bi-star-fill-nav-menu" aria-hidden="true"></span> Wishlist
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        UserStateService.OnUserChanged += HandleUserChanged;
    }

    private void HandleUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    public void Dispose()
    {
        UserStateService.OnUserChanged -= HandleUserChanged;
    }
}
