<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Slingcessories.Mobile.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Slingcessories.Mobile.Maui.Pages"
    Title="Slingcessories"
    FlyoutBackgroundColor="#f8f9fa">

    <ShellContent
        Title="Login"
        Icon="dotnet_bot.png"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage"
        FlyoutItemIsVisible="False" />

    <FlyoutItem Title="Accessories" Icon="dotnet_bot.png" Route="AccessoriesRoot">
        <ShellContent
            Title="Accessories"
            ContentTemplate="{DataTemplate pages:AccessoriesPage}"
            Route="AccessoriesPage" />
    </FlyoutItem>

    <FlyoutItem Title="Slingshots" Icon="dotnet_bot.png" Route="SlingshotsRoot">
        <ShellContent
            Title="Slingshots"
            ContentTemplate="{DataTemplate pages:SlingshotsPage}"
            Route="SlingshotsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Categories" Icon="dotnet_bot.png" Route="CategoriesRoot">
        <ShellContent
            Title="Categories"
            ContentTemplate="{DataTemplate pages:CategoriesPage}"
            Route="CategoriesPage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="dotnet_bot.png" Route="SettingsRoot">
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>

</Shell>
